<?xml version="1.0" encoding="utf-8"?>
<!--
    blood_spray — the wound effect. Fired by GoreManager::wound() and kill(),
    scaled by damage and aimed out of the wound with setEmitterDirection().

    Both groups use SPHERIC emitters on purpose: ParticleManager::setEmitterDirection
    only reaches SphericEmitter and StraightEmitter, so a 'normal' or 'random'
    emitter here would spray the same way no matter which way the shot came from.

    Alpha blending, not additive — blood darkens, it does not glow. That also
    keeps it clear of the EMT_TRANSPARENT_ADD_COLOR vertex-colour trap.
-->
<cereal>
    <ParticleSystem>
        <!-- Time multiplier, not a step count: ParticleManager does
             system->update(dt * updateRate). 1 = real time. Never 0. -->
        <updateRate>1</updateRate>
        <groups size="3">
            <!-- droplets: the fast arterial spray, streaked along travel -->
            <item0>
                <name>droplets</name>
                <capacity>32</capacity>
                <gravityX>0</gravityX>
                <gravityY>-14</gravityY>
                <gravityZ>0</gravityZ>
                <friction>0.4</friction>
                <model>
                    <lifetimeMin>0.35</lifetimeMin>
                    <lifetimeMax>0.85</lifetimeMax>
                    <enabledFlags size="5">
                        <item0>RED</item0>
                        <item1>GREEN</item1>
                        <item2>BLUE</item2>
                        <item3>ALPHA</item3>
                        <item4>SIZE</item4>
                    </enabledFlags>
                    <mutableFlags size="1">
                        <item0>ALPHA</item0>
                    </mutableFlags>
                    <randomFlags size="2">
                        <item0>SIZE</item0>
                        <item1>RED</item1>
                    </randomFlags>
                    <interpolatedFlags size="0"></interpolatedFlags>
                    <params size="5">
                        <item0>
                            <!-- random: min, max — a little variation stops the
                                 spray reading as one flat colour -->
                            <name>RED</name>
                            <values size="2"><item0>0.42</item0><item1>0.62</item1></values>
                        </item0>
                        <item1>
                            <name>GREEN</name>
                            <values size="1"><item0>0.03</item0></values>
                        </item1>
                        <item2>
                            <name>BLUE</name>
                            <values size="1"><item0>0.03</item0></values>
                        </item2>
                        <item3>
                            <!-- mutable: start, end — holds opaque then cuts,
                                 so droplets vanish rather than ghosting out -->
                            <name>ALPHA</name>
                            <values size="2"><item0>1</item0><item1>0.15</item1></values>
                        </item3>
                        <item4>
                            <!-- random: min, max -->
                            <name>SIZE</name>
                            <values size="2"><item0>0.06</item0><item1>0.17</item1></values>
                        </item4>
                    </params>
                    <interpolators size="0"></interpolators>
                </model>
                <renderer>
                    <texturePath>content/texture/particle/blood1.png</texturePath>
                    <blending>alpha</blending>
                    <orientation>direction_aligned</orientation>
                    <atlasW>1</atlasW>
                    <atlasH>1</atlasH>
                    <scaleX>0.5</scaleX>
                    <scaleY>1.4</scaleY>
                    <depthWrite>0</depthWrite>
                    <alphaTest>0</alphaTest>
                    <alphaTestThreshold>0</alphaTestThreshold>
                    <lookX>0</lookX><lookY>0</lookY><lookZ>-1</lookZ>
                    <upX>0</upX><upY>1</upY><upZ>0</upZ>
                </renderer>
                <emitters size="1">
                    <item0>
                        <type>spheric</type>
                        <zone>
                            <type>sphere</type>
                            <cx>0</cx><cy>0</cy><cz>0</cz>
                            <radius>0.04</radius>
                            <hx>0</hx><hy>0</hy><hz>0</hz>
                        </zone>
                        <fullZone>1</fullZone>
                        <tank>32</tank>
                        <flow>-1</flow>
                        <forceMin>2.5</forceMin>
                        <forceMax>7</forceMax>
                        <dirX>0</dirX><dirY>1</dirY><dirZ>0</dirZ>
                        <angleMin>0</angleMin>
                        <angleMax>1.1</angleMax>
                    </item0>
                </emitters>
            </item0>

            <!-- gouts: slow heavy blobs that carry and fall, sells the weight -->
            <item1>
                <name>gouts</name>
                <capacity>10</capacity>
                <gravityX>0</gravityX>
                <gravityY>-9</gravityY>
                <gravityZ>0</gravityZ>
                <friction>0.2</friction>
                <model>
                    <lifetimeMin>0.5</lifetimeMin>
                    <lifetimeMax>1.1</lifetimeMax>
                    <enabledFlags size="5">
                        <item0>RED</item0>
                        <item1>GREEN</item1>
                        <item2>BLUE</item2>
                        <item3>ALPHA</item3>
                        <item4>SIZE</item4>
                    </enabledFlags>
                    <mutableFlags size="1">
                        <item0>ALPHA</item0>
                    </mutableFlags>
                    <randomFlags size="1">
                        <item0>SIZE</item0>
                    </randomFlags>
                    <interpolatedFlags size="0"></interpolatedFlags>
                    <params size="5">
                        <item0>
                            <name>RED</name>
                            <values size="1"><item0>0.38</item0></values>
                        </item0>
                        <item1>
                            <name>GREEN</name>
                            <values size="1"><item0>0.02</item0></values>
                        </item1>
                        <item2>
                            <name>BLUE</name>
                            <values size="1"><item0>0.02</item0></values>
                        </item2>
                        <item3>
                            <!-- mutable: start, end -->
                            <name>ALPHA</name>
                            <values size="2"><item0>1</item0><item1>0</item1></values>
                        </item3>
                        <item4>
                            <!-- random: min, max -->
                            <name>SIZE</name>
                            <values size="2"><item0>0.16</item0><item1>0.34</item1></values>
                        </item4>
                    </params>
                    <interpolators size="0"></interpolators>
                </model>
                <renderer>
                    <texturePath>content/texture/particle/blood3.png</texturePath>
                    <blending>alpha</blending>
                    <orientation>camera_plane</orientation>
                    <atlasW>1</atlasW>
                    <atlasH>1</atlasH>
                    <scaleX>1</scaleX>
                    <scaleY>1</scaleY>
                    <depthWrite>0</depthWrite>
                    <alphaTest>0</alphaTest>
                    <alphaTestThreshold>0</alphaTestThreshold>
                    <lookX>0</lookX><lookY>0</lookY><lookZ>-1</lookZ>
                    <upX>0</upX><upY>1</upY><upZ>0</upZ>
                </renderer>
                <emitters size="1">
                    <item0>
                        <type>spheric</type>
                        <zone>
                            <type>sphere</type>
                            <cx>0</cx><cy>0</cy><cz>0</cz>
                            <radius>0.06</radius>
                            <hx>0</hx><hy>0</hy><hz>0</hz>
                        </zone>
                        <fullZone>1</fullZone>
                        <tank>10</tank>
                        <flow>-1</flow>
                        <forceMin>1</forceMin>
                        <forceMax>3</forceMax>
                        <dirX>0</dirX><dirY>1</dirY><dirZ>0</dirZ>
                        <angleMin>0</angleMin>
                        <angleMax>1.5</angleMax>
                    </item0>
                </emitters>
            </item1>

            <!-- mist: the soft hanging puff at the wound itself -->
            <item2>
                <name>mist</name>
                <capacity>6</capacity>
                <gravityX>0</gravityX>
                <gravityY>-0.6</gravityY>
                <gravityZ>0</gravityZ>
                <friction>1.6</friction>
                <model>
                    <lifetimeMin>0.22</lifetimeMin>
                    <lifetimeMax>0.45</lifetimeMax>
                    <enabledFlags size="5">
                        <item0>RED</item0>
                        <item1>GREEN</item1>
                        <item2>BLUE</item2>
                        <item3>ALPHA</item3>
                        <item4>SIZE</item4>
                    </enabledFlags>
                    <mutableFlags size="2">
                        <item0>ALPHA</item0>
                        <item1>SIZE</item1>
                    </mutableFlags>
                    <randomFlags size="0"></randomFlags>
                    <interpolatedFlags size="0"></interpolatedFlags>
                    <params size="5">
                        <item0>
                            <name>RED</name>
                            <values size="1"><item0>0.3</item0></values>
                        </item0>
                        <item1>
                            <name>GREEN</name>
                            <values size="1"><item0>0.02</item0></values>
                        </item1>
                        <item2>
                            <name>BLUE</name>
                            <values size="1"><item0>0.04</item0></values>
                        </item2>
                        <item3>
                            <!-- mutable: start, end -->
                            <name>ALPHA</name>
                            <values size="2"><item0>0.75</item0><item1>0</item1></values>
                        </item3>
                        <item4>
                            <!-- mutable: start, end — expands as it dissipates -->
                            <name>SIZE</name>
                            <values size="2"><item0>0.25</item0><item1>0.8</item1></values>
                        </item4>
                    </params>
                    <interpolators size="0"></interpolators>
                </model>
                <renderer>
                    <texturePath>content/texture/particle/blood5.png</texturePath>
                    <blending>alpha</blending>
                    <orientation>camera_plane</orientation>
                    <atlasW>1</atlasW>
                    <atlasH>1</atlasH>
                    <scaleX>1</scaleX>
                    <scaleY>1</scaleY>
                    <depthWrite>0</depthWrite>
                    <alphaTest>0</alphaTest>
                    <alphaTestThreshold>0</alphaTestThreshold>
                    <lookX>0</lookX><lookY>0</lookY><lookZ>-1</lookZ>
                    <upX>0</upX><upY>1</upY><upZ>0</upZ>
                </renderer>
                <emitters size="1">
                    <item0>
                        <type>spheric</type>
                        <zone>
                            <type>sphere</type>
                            <cx>0</cx><cy>0</cy><cz>0</cz>
                            <radius>0.08</radius>
                            <hx>0</hx><hy>0</hy><hz>0</hz>
                        </zone>
                        <fullZone>1</fullZone>
                        <tank>6</tank>
                        <flow>-1</flow>
                        <forceMin>0.2</forceMin>
                        <forceMax>0.9</forceMax>
                        <dirX>0</dirX><dirY>1</dirY><dirZ>0</dirZ>
                        <angleMin>0</angleMin>
                        <angleMax>2.2</angleMax>
                    </item0>
                </emitters>
            </item2>
        </groups>
    </ParticleSystem>
</cereal>
