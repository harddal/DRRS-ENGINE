                <name>cap</name>
                <capacity>22</capacity>
                <gravityX>0</gravityX><gravityY>0.25</gravityY><gravityZ>0</gravityZ>
                <friction>0.45</friction>
                <model>
                    <lifetimeMin>5.0</lifetimeMin>
                    <lifetimeMax>8.0</lifetimeMax>
                    <enabledFlags size="7">
                        <item0>RED</item0>
                        <item1>GREEN</item1>
                        <item2>BLUE</item2>
                        <item3>ALPHA</item3>
                        <item4>SIZE</item4>
                        <item5>ANGLE</item5>
                        <item6>TEXTURE_INDEX</item6>
                    </enabledFlags>
                    <mutableFlags size="1">
                        <item0>ANGLE</item0>
                    </mutableFlags>
                    <randomFlags size="2">
                        <item0>ANGLE</item0>
                        <item1>TEXTURE_INDEX</item1>
                    </randomFlags>
                    <interpolatedFlags size="2">
                        <item0>ALPHA</item0>
                        <item1>SIZE</item1>
                    </interpolatedFlags>
                    <params size="4">
                        <item0>
                            <name>RED</name>
                            <values size="1"><item0>0.35</item0></values>
                        </item0>
                        <item1>
                            <name>GREEN</name>
                            <values size="1"><item0>0.28</item0></values>
                        </item1>
                        <item2>
                            <name>BLUE</name>
                            <values size="1"><item0>0.2</item0></values>
                        </item2>
                        <item3>
                            <!-- ANGLE: mutable+random — slow random spin over lifetime -->
                            <name>ANGLE</name>
                            <values size="4">
                                <item0>0</item0>
                                <item1>6.2831853</item1>
                                <item2>0</item2>
                                <item3>6.2831853</item3>
                            </values>
                        </item3>
                    </params>
                    <interpolators size="2">
                        <item0>
                            <param>SIZE</param>
                            <entries size="5">
                                <item0><lifeRatio>0</lifeRatio><min>0.01</min><max>0.01</max></item0>
                                <item1><lifeRatio>0.45</lifeRatio><min>0.01</min><max>0.01</max></item1>
                                <item2><lifeRatio>0.57</lifeRatio><min>2.5</min><max>2.5</max></item2>
                                <item3><lifeRatio>0.75</lifeRatio><min>4.0</min><max>4.0</max></item3>
