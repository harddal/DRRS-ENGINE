<?xml version="1.0" encoding="utf-8"?>
<cereal>
    <ParticleSystem>
        <updateRate>2</updateRate>
        <groups size="6">
            <!-- flash: bright initial burst -->
            <item0>
                <name>flash</name>
                <capacity>4</capacity>
                <gravityX>0</gravityX><gravityY>0</gravityY><gravityZ>0</gravityZ>
                <friction>0</friction>
                <model>
                    <lifetimeMin>0.35</lifetimeMin>
                    <lifetimeMax>0.35</lifetimeMax>
                    <enabledFlags size="3">
                        <item0>ALPHA</item0>
                        <item1>SIZE</item1>
                        <item2>ANGLE</item2>
                    </enabledFlags>
                    <mutableFlags size="0"></mutableFlags>
                    <randomFlags size="1"><item0>ANGLE</item0></randomFlags>
                    <interpolatedFlags size="2">
                        <item0>ALPHA</item0>
                        <item1>SIZE</item1>
                    </interpolatedFlags>
                    <params size="1">
                        <item0>
                            <name>ANGLE</name>
                            <values size="2"><item0>0</item0><item1>6.2831853</item1></values>
                        </item0>
                    </params>
                    <interpolators size="2">
                        <item0>
                            <param>SIZE</param>
                            <entries size="2">
                                <item0><lifeRatio>0</lifeRatio><min>0.5</min><max>0.5</max></item0>
                                <item1><lifeRatio>0.25</lifeRatio><min>8.0</min><max>8.0</max></item1>
                            </entries>
                        </item0>
                        <item1>
                            <param>ALPHA</param>
                            <entries size="2">
                                <item0><lifeRatio>0</lifeRatio><min>1</min><max>1</max></item0>
                                <item1><lifeRatio>0.35</lifeRatio><min>0</min><max>0</max></item1>
                            </entries>
                        </item1>
                    </interpolators>
                </model>
                <renderer>
                    <texturePath>content/texture/particle/circle_01.png</texturePath>
                    <blending>add</blending>
                    <orientation>camera_plane</orientation>
                    <atlasW>1</atlasW><atlasH>1</atlasH>
                    <scaleX>1</scaleX><scaleY>1</scaleY>
                    <depthWrite>0</depthWrite>
                    <alphaTest>0</alphaTest>
                    <alphaTestThreshold>0</alphaTestThreshold>
                    <lookX>0</lookX><lookY>0</lookY><lookZ>-1</lookZ>
                    <upX>0</upX><upY>1</upY><upZ>0</upZ>
                </renderer>
                <emitters size="1">
                    <item0>
                        <type>static</type>
                        <zone>
                            <type>point</type>
                            <cx>0</cx><cy>0</cy><cz>0</cz>
                            <radius>0</radius><hx>0</hx><hy>0</hy><hz>0</hz>
                        </zone>
                        <fullZone>1</fullZone>
                        <tank>4</tank>
                        <flow>-1</flow>
                        <forceMin>0</forceMin>
                        <forceMax>0</forceMax>
                    </item0>
                </emitters>
            </item0>

            <!-- fireball: expanding orange-red core -->
            <item1>
                <name>fireball</name>
                <capacity>12</capacity>
                <gravityX>0</gravityX><gravityY>0.4</gravityY><gravityZ>0</gravityZ>
                <friction>0</friction>
                <model>
                    <lifetimeMin>1.5</lifetimeMin>
                    <lifetimeMax>2.0</lifetimeMax>
                    <enabledFlags size="7">
                        <item0>RED</item0>
                        <item1>GREEN</item1>
                        <item2>BLUE</item2>
                        <item3>ALPHA</item3>
                        <item4>SIZE</item4>
                        <item5>ANGLE</item5>
                        <item6>TEXTURE_INDEX</item6>
                    </enabledFlags>
                    <mutableFlags size="3">
                        <item0>RED</item0>
                        <item1>GREEN</item1>
                        <item2>BLUE</item2>
                    </mutableFlags>
                    <randomFlags size="2">
                        <item0>ANGLE</item0>
                        <item1>TEXTURE_INDEX</item1>
                    </randomFlags>
                    <interpolatedFlags size="2">
                        <item0>ALPHA</item0>
                        <item1>SIZE</item1>
                    </interpolatedFlags>
                    <params size="5">
                        <item0>
                            <name>RED</name>
                            <values size="2"><item0>1.0</item0><item1>0.35</item1></values>
                        </item0>
                        <item1>
                            <name>GREEN</name>
                            <values size="2"><item0>0.5</item0><item1>0.12</item1></values>
                        </item1>
                        <item2>
                            <name>BLUE</name>
                            <values size="2"><item0>0.1</item0><item1>0.05</item1></values>
                        </item2>
                        <item3>
                            <name>ANGLE</name>
                            <values size="2"><item0>0</item0><item1>6.2831853</item1></values>
                        </item3>
                        <item4>
                            <name>TEXTURE_INDEX</name>
                            <values size="2"><item0>0</item0><item1>4</item1></values>
                        </item4>
                    </params>
                    <interpolators size="2">
                        <item0>
                            <param>SIZE</param>
                            <entries size="4">
                                <item0><lifeRatio>0</lifeRatio><min>0.8</min><max>0.8</max></item0>
                                <item1><lifeRatio>0.12</lifeRatio><min>4.0</min><max>4.0</max></item1>
                                <item2><lifeRatio>0.5</lifeRatio><min>5.5</min><max>5.5</max></item2>
                                <item3><lifeRatio>1.0</lifeRatio><min>4.5</min><max>4.5</max></item3>
                            </entries>
                        </item0>
                        <item1>
                            <param>ALPHA</param>
                            <entries size="4">
                                <item0><lifeRatio>0</lifeRatio><min>1.0</min><max>1.0</max></item0>
                                <item1><lifeRatio>0.35</lifeRatio><min>0.9</min><max>0.9</max></item1>
                                <item2><lifeRatio>0.7</lifeRatio><min>0.4</min><max>0.4</max></item2>
                                <item3><lifeRatio>1.0</lifeRatio><min>0.0</min><max>0.0</max></item3>
