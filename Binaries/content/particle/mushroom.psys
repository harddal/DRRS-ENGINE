                        <item0>ANGLE</item0>
                    </mutableFlags>
                    <randomFlags size="2">
                        <item0>ANGLE</item0>
                        <item1>TEXTURE_INDEX</item1>
                    </randomFlags>
                    <interpolatedFlags size="2">
                        <item0>ALPHA</item0>
                        <item1>SIZE</item1>
                    </interpolatedFlags>
                    <params size="4">
                        <item0>
                            <name>RED</name>
                            <values size="1"><item0>0.28</item0></values>
                        </item0>
                        <item1>
                            <name>GREEN</name>
                            <values size="1"><item0>0.22</item0></values>
                        </item1>
                        <item2>
                            <name>BLUE</name>
                            <values size="1"><item0>0.16</item0></values>
                        </item2>
                        <item3>
                            <!-- ANGLE: mutable+random — birth and death both full range -->
                            <name>ANGLE</name>
                            <values size="4">
                                <item0>0</item0>
                                <item1>6.2831853</item1>
                                <item2>0</item2>
                                <item3>6.2831853</item3>
                            </values>
                        </item3>
                    </params>
                    <interpolators size="2">
                        <item0>
                            <param>SIZE</param>
                            <entries size="4">
                                <item0><lifeRatio>0</lifeRatio><min>0.4</min><max>0.4</max></item0>
                                <item1><lifeRatio>0.2</lifeRatio><min>1.5</min><max>1.5</max></item1>
                                <item2><lifeRatio>0.6</lifeRatio><min>2.5</min><max>2.5</max></item2>
                                <item3><lifeRatio>1.0</lifeRatio><min>2.0</min><max>2.0</max></item3>
                            </entries>
                        </item0>
                        <item1>
                            <param>ALPHA</param>
