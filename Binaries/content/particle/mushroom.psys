                                <item1><lifeRatio>0.45</lifeRatio><min>0</min><max>0</max></item1>
                                <item2><lifeRatio>0.55</lifeRatio><min>0.75</min><max>0.75</max></item2>
                                <item3><lifeRatio>0.75</lifeRatio><min>0.6</min><max>0.6</max></item3>
                                <item4><lifeRatio>1.0</lifeRatio><min>0</min><max>0</max></item4>
                            </entries>
                        </item1>
