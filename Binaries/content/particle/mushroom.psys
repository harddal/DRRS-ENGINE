                        <zone>
                            <type>sphere</type>
                            <cx>0</cx><cy>6</cy><cz>0</cz>
                            <radius>1.2</radius><hx>0</hx><hy>0</hy><hz>0</hz>
                        </zone>
                        <fullZone>0</fullZone>
                        <tank>22</tank>
