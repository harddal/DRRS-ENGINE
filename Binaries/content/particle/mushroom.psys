                            <radius>0.4</radius><hx>0</hx><hy>0</hy><hz>0</hz>
                        </zone>
                        <fullZone>1</fullZone>
                        <tank>12</tank>
                        <flow>-1</flow>
                        <forceMin>0.4</forceMin>
                        <forceMax>1.0</forceMax>
                    </item0>
