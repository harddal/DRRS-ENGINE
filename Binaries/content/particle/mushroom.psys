            <!-- stem: smoke column pulled upward by positive gravity -->
            <item2>
                <name>stem</name>
                <capacity>25</capacity>
                <gravityX>0</gravityX><gravityY>1.8</gravityY><gravityZ>0</gravityZ>
                <friction>0.25</friction>
                <model>
                    <lifetimeMin>3.0</lifetimeMin>
                    <lifetimeMax>5.0</lifetimeMax>
                    <enabledFlags size="7">
                        <item0>RED</item0>
                        <item1>GREEN</item1>
                        <item2>BLUE</item2>
                        <item3>ALPHA</item3>
                        <item4>SIZE</item4>
                        <item5>ANGLE</item5>
                        <item6>TEXTURE_INDEX</item6>
                    </enabledFlags>
