<?xml version="1.0" encoding="utf-8"?>
<!--
    water_bubbles — the trail a shot leaves through water.

    NOT a spawn-per-shot effect. WaterBallistics keeps ONE persistent instance
    of this at the world origin (ParticleManager::spawnPersistent) and feeds it
    by hand with ParticleManager::emitAlongLine() for the underwater span of
    each shot. The emitter therefore never emits on its own (tank 0, flow 0):
    it exists only to hand each bubble its starting velocity — a slow upward
    puff spread out to a cone, so the line breaks up instead of rising as a rod.

    RISE BUDGET. One system serves every pool, so there is no per-pool surface
    to kill bubbles at. Instead they are sized never to reach it: positive
    gravity (buoyancy) against heavy friction gives a terminal rise of about
    gravityY / friction = 0.4 u/s, and with lifetime <= 1.2 s plus the initial
    puff that is ~0.55 units at most. WaterBallistics keeps every trail
    kBubbleSurfaceClearance (0.6) below the surface to match. Raise gravity,
    lifetime or force here and that constant has to grow with them, or bubbles
    will float up out of the water.

    Capacity 2000 covers a minigun burst (~20 shots/s x up to 48 bubbles x ~1 s);
    past that SPARK drops the extras, which is fine under load.
-->
<cereal>
    <ParticleSystem>
        <updateRate>1</updateRate>
        <groups size="1">
            <item0>
                <name>bubbles</name>
                <capacity>2000</capacity>
                <gravityX>0</gravityX>
                <gravityY>1.2</gravityY>
                <gravityZ>0</gravityZ>
                <friction>3</friction>
                <model>
                    <lifetimeMin>0.6</lifetimeMin>
                    <lifetimeMax>1.2</lifetimeMax>
                    <enabledFlags size="5">
                        <item0>RED</item0>
                        <item1>GREEN</item1>
                        <item2>BLUE</item2>
                        <item3>ALPHA</item3>
                        <item4>SIZE</item4>
                    </enabledFlags>
                    <mutableFlags size="1">
                        <item0>SIZE</item0>
                    </mutableFlags>
                    <randomFlags size="1">
                        <item0>SIZE</item0>
                    </randomFlags>
                    <interpolatedFlags size="1">
                        <item0>ALPHA</item0>
                    </interpolatedFlags>
                    <params size="4">
                        <item0>
                            <name>RED</name>
                            <values size="1"><item0>0.85</item0></values>
                        </item0>
                        <item1>
                            <name>GREEN</name>
                            <values size="1"><item0>0.95</item0></values>
                        </item1>
                        <item2>
                            <name>BLUE</name>
                            <values size="1"><item0>1.0</item0></values>
                        </item2>
                        <item3>
                            <!-- mutable + random: startMin, startMax, endMin, endMax.
                                 Bubbles swell a little as they rise. -->
                            <name>SIZE</name>
                            <values size="4"><item0>0.03</item0><item1>0.07</item1><item2>0.05</item2><item3>0.1</item3></values>
                        </item3>
                    </params>
                    <interpolators size="1">
                        <item0>
                            <!-- quick fade-in so the trail does not pop, long hold, late fade -->
                            <param>ALPHA</param>
                            <entries size="4">
                                <item0><lifeRatio>0</lifeRatio><min>0</min><max>0</max></item0>
                                <item1><lifeRatio>0.08</lifeRatio><min>0.8</min><max>0.8</max></item1>
                                <item2><lifeRatio>0.6</lifeRatio><min>0.6</min><max>0.6</max></item2>
                                <item3><lifeRatio>1.0</lifeRatio><min>0</min><max>0</max></item3>
                            </entries>
                        </item0>
                    </interpolators>
                </model>
                <renderer>
                    <!-- placeholder until a dedicated bubble sprite (ring + highlight) exists -->
                    <texturePath>content/texture/particle/circle_02.png</texturePath>
                    <blending>alpha</blending>
                    <orientation>camera_plane</orientation>
                    <atlasW>1</atlasW>
                    <atlasH>1</atlasH>
                    <scaleX>1</scaleX>
                    <scaleY>1</scaleY>
                    <depthWrite>0</depthWrite>
                    <alphaTest>0</alphaTest>
                    <alphaTestThreshold>0</alphaTestThreshold>
                    <lookX>0</lookX><lookY>0</lookY><lookZ>-1</lookZ>
                    <upX>0</upX><upY>1</upY><upZ>0</upZ>
                </renderer>
                <emitters size="1">
                    <item0>
                        <!-- velocity source only; tank 0 + flow 0 = never self-emits -->
                        <type>spheric</type>
                        <zone>
                            <type>point</type>
                            <cx>0</cx><cy>0</cy><cz>0</cz>
                            <radius>0</radius>
                            <hx>0</hx><hy>0</hy><hz>0</hz>
                        </zone>
                        <fullZone>1</fullZone>
                        <tank>0</tank>
                        <flow>0</flow>
                        <forceMin>0.1</forceMin>
                        <forceMax>0.35</forceMax>
                        <dirX>0</dirX><dirY>1</dirY><dirZ>0</dirZ>
                        <angleMin>0</angleMin><angleMax>1.2</angleMax>
                    </item0>
                </emitters>
            </item0>
        </groups>
    </ParticleSystem>
</cereal>
