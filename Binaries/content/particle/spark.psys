<?xml version="1.0" encoding="utf-8"?>
<cereal>
    <ParticleSystem>
        <updateRate>500</updateRate>
        <groups size="3">
            <!-- flash -->
            <item0>
                <name>flash</name>
                <capacity>1</capacity>
                <gravityX>0</gravityX>
                <gravityY>0</gravityY>
                <gravityZ>0</gravityZ>
                <friction>0</friction>
                <model>
                    <lifetimeMin>0.08</lifetimeMin>
                    <lifetimeMax>0.14</lifetimeMax>
                    <enabledFlags size="5">
                        <item0>RED</item0>
                        <item1>GREEN</item1>
                        <item2>BLUE</item2>
                        <item3>ALPHA</item3>
                        <item4>SIZE</item4>
                    </enabledFlags>
                    <mutableFlags size="2">
                        <item0>ALPHA</item0>
                        <item1>SIZE</item1>
                    </mutableFlags>
                    <randomFlags size="0"></randomFlags>
                    <interpolatedFlags size="0"></interpolatedFlags>
                    <params size="5">
                        <item0>
                            <name>RED</name>
                            <values size="1"><item0>1</item0></values>
                        </item0>
                        <item1>
                            <name>GREEN</name>
                            <values size="1"><item0>1</item0></values>
                        </item1>
                        <item2>
                            <name>BLUE</name>
                            <values size="1"><item0>1</item0></values>
                        </item2>
                        <item3>
                            <!-- mutable: start, end -->
                            <name>ALPHA</name>
                            <values size="2"><item0>1</item0><item1>0</item1></values>
                        </item3>
                        <item4>
                            <!-- mutable: start, end -->
                            <name>SIZE</name>
                            <values size="2"><item0>0.6</item0><item1>0.05</item1></values>
                        </item4>
                    </params>
                    <interpolators size="0"></interpolators>
                </model>
                <renderer>
                    <texturePath>content/texture/particle/star_04.png</texturePath>
                    <blending>add</blending>
                    <orientation>camera_plane</orientation>
                    <atlasW>1</atlasW>
                    <atlasH>1</atlasH>
                    <scaleX>1</scaleX>
                    <scaleY>1</scaleY>
                    <depthWrite>0</depthWrite>
                    <alphaTest>0</alphaTest>
                    <alphaTestThreshold>0</alphaTestThreshold>
                    <lookX>0</lookX><lookY>0</lookY><lookZ>-1</lookZ>
                    <upX>0</upX><upY>1</upY><upZ>0</upZ>
                </renderer>
                <emitters size="1">
                    <item0>
                        <type>normal</type>
                        <zone>
                            <type>sphere</type>
                            <cx>0</cx><cy>0</cy><cz>0</cz>
                            <radius>0.01</radius>
                            <hx>0</hx><hy>0</hy><hz>0</hz>
                        </zone>
                        <fullZone>0</fullZone>
                        <tank>1</tank>
                        <flow>-1</flow>
                        <forceMin>0</forceMin>
                        <forceMax>0.1</forceMax>
                    </item0>
                </emitters>
            </item0>
            <!-- spark -->
            <item1>
                <name>spark</name>
                <capacity>18</capacity>
                <gravityX>0</gravityX>
                <gravityY>-4</gravityY>
                <gravityZ>0</gravityZ>
                <friction>0</friction>
                <model>
                    <lifetimeMin>0.25</lifetimeMin>
                    <lifetimeMax>0.6</lifetimeMax>
                    <enabledFlags size="5">
                        <item0>RED</item0>
                        <item1>GREEN</item1>
                        <item2>BLUE</item2>
                        <item3>ALPHA</item3>
                        <item4>SIZE</item4>
                    </enabledFlags>
                    <mutableFlags size="4">
                        <item0>ALPHA</item0>
                        <item1>RED</item1>
                        <item2>GREEN</item2>
                        <item3>BLUE</item3>
                    </mutableFlags>
                    <randomFlags size="1">
                        <item0>SIZE</item0>
                    </randomFlags>
                    <interpolatedFlags size="0"></interpolatedFlags>
                    <params size="5">
                        <item0>
                            <!-- mutable: start, end -->
                            <name>RED</name>
                            <values size="2"><item0>1</item0><item1>0.3</item1></values>
                        </item0>
                        <item1>
                            <!-- mutable: start, end -->
                            <name>GREEN</name>
                            <values size="2"><item0>1</item0><item1>0.4</item1></values>
                        </item1>
                        <item2>
                            <!-- mutable: start, end -->
                            <name>BLUE</name>
                            <values size="2"><item0>1</item0><item1>1</item1></values>
                        </item2>
                        <item3>
                            <!-- mutable: start, end -->
                            <name>ALPHA</name>
                            <values size="2"><item0>1</item0><item1>0</item1></values>
                        </item3>
                        <item4>
                            <!-- random: min, max -->
                            <name>SIZE</name>
                            <values size="2"><item0>0.08</item0><item1>0.18</item1></values>
                        </item4>
                    </params>
                    <interpolators size="0"></interpolators>
                </model>
                <renderer>
                    <texturePath>content/texture/particle/spark1.bmp</texturePath>
                    <blending>add</blending>
                    <orientation>direction_aligned</orientation>
                    <atlasW>1</atlasW>
                    <atlasH>1</atlasH>
                    <scaleX>0.03</scaleX>
                    <scaleY>1</scaleY>
                    <depthWrite>0</depthWrite>
                    <alphaTest>0</alphaTest>
                    <alphaTestThreshold>0</alphaTestThreshold>
                    <lookX>0</lookX><lookY>0</lookY><lookZ>-1</lookZ>
                    <upX>0</upX><upY>1</upY><upZ>0</upZ>
                </renderer>
                <emitters size="1">
                    <item0>
                        <type>normal</type>
                        <zone>
                            <type>sphere</type>
                            <cx>0</cx><cy>0</cy><cz>0</cz>
                            <radius>0.05</radius>
                            <hx>0</hx><hy>0</hy><hz>0</hz>
                        </zone>
                        <fullZone>1</fullZone>
                        <tank>18</tank>
                        <flow>-1</flow>
                        <forceMin>2</forceMin>
                        <forceMax>5</forceMax>
                    </item0>
                </emitters>
            </item1>
            <!-- glow -->
            <item2>
                <name>glow</name>
                <capacity>4</capacity>
                <gravityX>0</gravityX>
                <gravityY>0</gravityY>
                <gravityZ>0</gravityZ>
                <friction>0</friction>
                <model>
                    <lifetimeMin>0.15</lifetimeMin>
                    <lifetimeMax>0.3</lifetimeMax>
                    <enabledFlags size="5">
                        <item0>RED</item0>
                        <item1>GREEN</item1>
                        <item2>BLUE</item2>
                        <item3>ALPHA</item3>
                        <item4>SIZE</item4>
                    </enabledFlags>
                    <mutableFlags size="2">
                        <item0>ALPHA</item0>
                        <item1>SIZE</item1>
                    </mutableFlags>
                    <randomFlags size="0"></randomFlags>
                    <interpolatedFlags size="0"></interpolatedFlags>
                    <params size="5">
                        <item0>
                            <name>RED</name>
                            <values size="1"><item0>1</item0></values>
                        </item0>
                        <item1>
                            <name>GREEN</name>
                            <values size="1"><item0>0.99</item0></values>
                        </item1>
                        <item2>
                            <name>BLUE</name>
                            <values size="1"><item0>0.77</item0></values>
                        </item2>
                        <item3>
                            <!-- mutable: start, end -->
                            <name>ALPHA</name>
                            <values size="2"><item0>0.6</item0><item1>0</item1></values>
                        </item3>
                        <item4>
                            <!-- mutable: start, end -->
                            <name>SIZE</name>
                            <values size="2"><item0>0.1</item0><item1>0.55</item1></values>
                        </item4>
                    </params>
                    <interpolators size="0"></interpolators>
                </model>
                <renderer>
                    <texturePath>content/texture/particle/flame_04.png</texturePath>
                    <blending>add</blending>
                    <orientation>camera_plane</orientation>
                    <atlasW>1</atlasW>
                    <atlasH>1</atlasH>
                    <scaleX>1</scaleX>
                    <scaleY>1</scaleY>
                    <depthWrite>0</depthWrite>
                    <alphaTest>0</alphaTest>
                    <alphaTestThreshold>0</alphaTestThreshold>
                    <lookX>0</lookX><lookY>0</lookY><lookZ>-1</lookZ>
                    <upX>0</upX><upY>1</upY><upZ>0</upZ>
                </renderer>
                <emitters size="1">
                    <item0>
                        <type>normal</type>
                        <zone>
                            <type>sphere</type>
                            <cx>0</cx><cy>0</cy><cz>0</cz>
                            <radius>0.04</radius>
                            <hx>0</hx><hy>0</hy><hz>0</hz>
                        </zone>
                        <fullZone>0</fullZone>
                        <tank>4</tank>
                        <flow>-1</flow>
                        <forceMin>0.1</forceMin>
                        <forceMax>0.4</forceMax>
                    </item0>
                </emitters>
            </item2>
        </groups>
    </ParticleSystem>
</cereal>
