#include "../entity.asc"

[export]
int g_healthValue = 25;

// Gate in front of onUse. Returning false means "using this now would do
// nothing", which is what lets an auto-use item be STORED rather than wasted:
// walk over a medkit at full health and it goes into the pouch for later.
bool canUse(entityid self)
{
	return player::health() < player::max_health();
}

void onUse(entityid self)
{
	player::heal(g_healthValue);
}
