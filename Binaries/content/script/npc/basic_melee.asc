#include "../entity.asc"
#include "../behavior/footstepsound.asc"

// ---- Exported parameters — tweak per NPC in the editor ----
[export]
float g_repathInterval    = 500.0f;   // ms between nav path updates during movement

[export]
float g_waypointRadius    = 0.5f;     // arrival distance for nav waypoints

[export]
float g_attackStartRange  = 3.0f;     // CHASE→ATTACK transition distance

[export]
float g_attackHysteresis  = 0.75f;    // extra buffer before exiting ATTACK back to CHASE

[export]
int   g_attackDamage      = 10;       // damage on a full, unblocked hit

[export]
int   g_blockDamage       = 3;        // damage when the player is blocking on impact

[export]
float g_windupFraction    = 0.6f;     // fraction of attackDelay spent telegraphing before damage lands

[export]
float g_strafeRadius      = 2.5f;     // orbit radius around the player during ATTACK

[export]
float g_strafeSpeed       = 0.6f;     // radians/second for the orbit

[export]
int   g_alertTimeout      = 4000;     // ms to investigate last-known-position before giving up

[export]
int   g_flinchDuration    = 400;      // ms to hold flinch pose when hit mid-windup

[export]
float g_patrolRepathInterval = 2000.0f; // ms between nav path updates during PATROL

// ---- Internal state ----
int   g_prevState        = 1;   // npc::STATE_IDLE
bool  g_isDead           = false;

// Attack pipeline
int   g_lastAttackTime   = 0;
bool  g_windupActive     = false;
bool  g_attackAnimPlayed = false;

// Flinch
bool  g_isFlinching      = false;
int   g_flinchStart      = 0;

// Strafe/orbit
float g_strafeAngle      = 0.0f;
int   g_strafeDir        = 1;

// ALERT investigation
vector3d g_lastKnownPos;
bool     g_hasLastKnown  = false;
int      g_alertStartTime = 0;

// Repath timers
float g_lastRepathTime   = 0.0f;
float g_lastPatrolRepath = 0.0f;

// LOS hold — brief grace period before reacting to lost sight
int   g_losLostTime      = -1;

// ---- LOS helper ----
// Casts from the player toward this NPC; returns true if clear.
bool hasLOS(entityid self, entityid player)
{
    vector3d me  = transform::position(self);
    vector3d plr = transform::position(player);
    vector3d dir = math::normalize(vector3d(me.x - plr.x, 0.0f, me.z - plr.z));
    vector3d a   = vector3d(plr.x,               plr.y + 0.8f, plr.z);
    vector3d b   = vector3d(me.x - dir.x * 0.6f, me.y  + 0.9f, me.z - dir.z * 0.6f);
    return !raycast::line(a, b);
}

// ---- Navigation helper — finds path and follows it ----
// Call every frame the NPC should move toward dest; handles repath timing internally.
void navigateTo(entityid self, vector3d dest, vector3d myPos, int now, float repathMs)
{
    if (npc::navPathSize(self) == 0 || now - int(g_lastRepathTime) > int(repathMs))
    {
        npc::findPath(self, dest);
        g_lastRepathTime = float(now);
    }

    while (npc::navPathIndex(self) < npc::navPathSize(self) - 1)
    {
        vector3d wp  = npc::navWaypoint(self, npc::navPathIndex(self));
        float    wdx = wp.x - myPos.x;
        float    wdz = wp.z - myPos.z;
        if (wdx * wdx + wdz * wdz < g_waypointRadius * g_waypointRadius)
            npc::advanceNavPath(self);
        else
            break;
    }

    if (npc::navPathSize(self) > 0)
        npc::moveTarget(self, npc::navWaypoint(self, npc::navPathIndex(self)));
    else
        npc::moveTarget(self, dest);
}

void init(entityid self)
{
    // Start in PATROL if the entity has waypoints configured, otherwise IDLE.
    if (npc::hasWaypoint(self))
        npc::state(self, npc::STATE_PATROL);
    else
        npc::state(self, npc::STATE_IDLE);

    g_prevState = npc::state(self);
    animation::play(self, "idle");
}

void npcUpdate(entityid self)
{
    if (g_isDead)
        return;

    if (!npc::alive(self))
    {
        g_isDead = true;
        npc::state(self, npc::STATE_DEAD);
        npc::stopMovement(self);
        animation::play(self, "die");
        sound::play(self, "die");
        return;
    }

    int      now       = time::get();
    entityid player    = entity::get("player");
    if (player < 0)
        return;

    vector3d myPos     = transform::position(self);
    vector3d playerPos = transform::position(player);
    float    dist      = math::distance(myPos, playerPos);
    float    vRange    = npc::visionRange(self);
    float    cRange    = npc::chaseRange(self);
    float    atkDelay  = npc::attackDelay(self);

    bool canSee = hasLOS(self, player);

    int curState = npc::state(self);

    // ================================================================
    // PATROL — follow waypoints until player is spotted
    // ================================================================
    if (curState == npc::STATE_PATROL)
    {
        if (g_prevState != npc::STATE_PATROL)
        {
            animation::loop(self, "move");
            g_lastPatrolRepath = 0.0f;
        }

        // Player spotted → CHASE
        if (dist <= vRange && canSee)
        {
            g_lastKnownPos = playerPos;
            g_hasLastKnown = true;
            npc::state(self, npc::STATE_CHASE);
            g_prevState = npc::STATE_PATROL;
            return;
        }

        if (npc::hasWaypoint(self))
        {
            vector3d wpPos = npc::currentWaypointPos(self);
            float wdx = wpPos.x - myPos.x;
            float wdz = wpPos.z - myPos.z;
            bool arrived = (wdx * wdx + wdz * wdz) < (g_waypointRadius * g_waypointRadius);

            if (arrived)
            {
                npc::advanceWaypoint(self);
                g_lastPatrolRepath = 0.0f;
            }
            else
            {
                navigateTo(self, wpPos, myPos, now, g_patrolRepathInterval);
                PlayFootStepSound(self, now, 900);
            }
        }
        else
        {
            // No waypoints left → rest in IDLE
            npc::state(self, npc::STATE_IDLE);
        }

        g_prevState = npc::STATE_PATROL;
        return;
    }

    // ================================================================
    // IDLE — stand still until player is spotted
    // ================================================================
    if (curState == npc::STATE_IDLE)
    {
        if (g_prevState != npc::STATE_IDLE)
        {
            npc::stopMovement(self);
            npc::clearNavPath(self);
            animation::loop(self, "idle");
        }

        if (dist <= vRange && canSee)
        {
            g_lastKnownPos = playerPos;
            g_hasLastKnown = true;
            npc::state(self, npc::STATE_CHASE);
        }

        g_prevState = npc::STATE_IDLE;
        return;
    }

    // ================================================================
    // ALERT — move to last-known-position, then give up
    // ================================================================
    if (curState == npc::STATE_ALERT)
    {
        if (g_prevState != npc::STATE_ALERT)
        {
            g_alertStartTime = now;
            animation::loop(self, "move");
        }

        // Player reacquired → CHASE
        if (canSee && dist <= vRange)
        {
            g_lastKnownPos = playerPos;
            npc::state(self, npc::STATE_CHASE);
            g_prevState = npc::STATE_ALERT;
            return;
        }

        bool timedOut = (now - g_alertStartTime) > g_alertTimeout;
        bool arrived  = g_hasLastKnown &&
                        (math::distance(myPos, g_lastKnownPos) < g_waypointRadius);

        if (timedOut || arrived)
        {
            g_hasLastKnown = false;
            npc::clearNavPath(self);
            // Return to PATROL if waypoints exist, otherwise IDLE
            if (npc::hasWaypoint(self))
                npc::state(self, npc::STATE_PATROL);
            else
                npc::state(self, npc::STATE_IDLE);
            g_prevState = npc::STATE_ALERT;
            return;
        }

        if (g_hasLastKnown)
            navigateTo(self, g_lastKnownPos, myPos, now, g_repathInterval);

        PlayFootStepSound(self, now, 800);
        g_prevState = npc::STATE_ALERT;
        return;
    }

    // ================================================================
    // CHASE — pursue the player using navmesh pathfinding
    // ================================================================
    if (curState == npc::STATE_CHASE)
    {
        if (g_prevState != npc::STATE_CHASE)
            animation::loop(self, "move");

        // In attack range → ATTACK
        if (dist <= g_attackStartRange)
        {
            npc::clearNavPath(self);
            npc::state(self, npc::STATE_ATTACK);
            g_prevState = npc::STATE_CHASE;
            return;
        }

        // Player too far away → ALERT (investigate last known) or IDLE
        if (dist > cRange)
        {
            npc::clearNavPath(self);
            if (g_hasLastKnown)
                npc::state(self, npc::STATE_ALERT);
            else if (npc::hasWaypoint(self))
                npc::state(self, npc::STATE_PATROL);
            else
                npc::state(self, npc::STATE_IDLE);
            g_losLostTime = -1;
            g_prevState   = npc::STATE_CHASE;
            return;
        }

        // LOS lost — wait briefly before reacting (prevents single-frame flicker)
        if (!canSee)
        {
            if (g_losLostTime < 0)
                g_losLostTime = now;

            if (now - g_losLostTime > 300)
            {
                npc::clearNavPath(self);
                g_hasLastKnown = true;
                npc::state(self, npc::STATE_ALERT);
                g_losLostTime = -1;
                g_prevState   = npc::STATE_CHASE;
                return;
            }

            // Still in grace period — keep moving toward last known position
            navigateTo(self, g_lastKnownPos, myPos, now, g_repathInterval);
            PlayFootStepSound(self, now, 800);
            g_prevState = npc::STATE_CHASE;
            return;
        }

        // LOS clear — reset hold timer and chase normally
        g_lastKnownPos = playerPos;
        g_losLostTime  = -1;
        navigateTo(self, playerPos, myPos, now, g_repathInterval);

        PlayFootStepSound(self, now, 800);
        g_prevState = npc::STATE_CHASE;
        return;
    }

    // ================================================================
    // ATTACK — orbit player, telegraph, apply damage, handle flinch
    // ================================================================
    if (curState == npc::STATE_ATTACK)
    {
        if (g_prevState != npc::STATE_ATTACK)
        {
            g_lastAttackTime   = now;
            g_windupActive     = true;
            g_attackAnimPlayed = false;
            g_isFlinching      = false;
            g_strafeDir        = (math::random(2) == 1) ? 1 : -1;
            g_strafeAngle      = 0.0f;
            g_lastRepathTime   = 0.0f;
        }

        // Player backed off → return to CHASE
        if (dist > g_attackStartRange + g_attackHysteresis)
        {
            g_windupActive = false;
            g_isFlinching  = false;
            npc::state(self, npc::STATE_CHASE);
            g_prevState = npc::STATE_ATTACK;
            return;
        }

        // Flinch check — interrupt windup if hit
        bool tookHit = hp::didReceiveDamage(self);
        if (tookHit && g_windupActive && !g_isFlinching)
        {
            g_windupActive   = false;
            g_isFlinching    = true;
            g_flinchStart    = now;
            g_lastAttackTime = now;
            animation::play(self, "hit");
            sound::play(self, "damage_" + string::to_string(math::random(2)));
            npc::stopMovement(self);
            g_prevState = npc::STATE_ATTACK;
            return;
        }

        // Hold flinch pose
        if (g_isFlinching)
        {
            if (now - g_flinchStart >= g_flinchDuration)
            {
                g_isFlinching      = false;
                g_windupActive     = true;
                g_attackAnimPlayed = false;
            }
            else
            {
                npc::stopMovement(self);
                g_prevState = npc::STATE_ATTACK;
                return;
            }
        }

        int elapsed = now - g_lastAttackTime;

        // Windup — telegraph attack before damage lands
        if (g_windupActive)
        {
            if (!g_attackAnimPlayed)
            {
                animation::play(self, "melee");
                g_attackAnimPlayed = true;
            }

            if (elapsed >= int(atkDelay * g_windupFraction))
            {
                int dmg = player::isBlocking() ? g_blockDamage : g_attackDamage;
                player::damage(dmg);
                sound::play(self, "attack");
                g_windupActive = false;
            }
        }

        // Recovery phase — wait for full attackDelay before next cycle
        if (!g_windupActive && !g_isFlinching)
        {
            if (elapsed >= int(atkDelay))
            {
                g_lastAttackTime   = now;
                g_windupActive     = true;
                g_attackAnimPlayed = false;
                g_strafeDir        = (math::random(2) == 1) ? 1 : -1;
            }
            else if (animation::last(self) != "move")
            {
                animation::loop(self, "move");
            }
        }

        // Strafe orbit around the player (suppressed during flinch)
        if (!g_isFlinching)
        {
            float dt = float(time::getDelta()) * 0.001f;
            g_strafeAngle += float(g_strafeDir) * g_strafeSpeed * dt;
            if (g_strafeAngle >  6.2832f) g_strafeAngle -= 6.2832f;
            if (g_strafeAngle < -6.2832f) g_strafeAngle += 6.2832f;

            float    tx          = playerPos.x + g_strafeRadius * math::cos(g_strafeAngle);
            float    tz          = playerPos.z + g_strafeRadius * math::sin(g_strafeAngle);
            vector3d orbitTarget = vector3d(tx, myPos.y, tz);
            navigateTo(self, orbitTarget, myPos, now, g_repathInterval);

            PlayFootStepSound(self, now, 600);
        }

        g_prevState = npc::STATE_ATTACK;
        return;
    }
}

void onKill(entityid self)
{
}
