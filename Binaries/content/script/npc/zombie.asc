#include "../entity.asc"
#include "../behavior/footstepsound.asc"

// ---- Exported parameters ----
[export]
int   g_attackDamage  = 10;    // damage per bite

[export]
float g_detectionMult = 1.0f;  // multiplier on visionRange for proximity detection (no LOS needed)

// ---- Internal state ----
bool g_isDead         = false;
int  g_lastAttackTime = 0;

// Nav helper: recomputes path when stale, sets moveTarget to next waypoint.
void zombieNavigateTo(entityid self, vector3d dest, vector3d myPos, int now)
{
    if (npc::navPathSize(self) == 0)
        npc::findPath(self, dest);

    while (npc::navPathIndex(self) < npc::navPathSize(self) - 1)
    {
        vector3d wp  = npc::navWaypoint(self, npc::navPathIndex(self));
        float    dx  = wp.x - myPos.x;
        float    dz  = wp.z - myPos.z;
        if (dx * dx + dz * dz < 0.5f * 0.5f)
            npc::advanceNavPath(self);
        else
            break;
    }

    if (npc::navPathSize(self) > 0)
        npc::moveTarget(self, npc::navWaypoint(self, npc::navPathIndex(self)));
    else
        npc::moveTarget(self, dest);
}

void init(entityid self)
{
    npc::state(self, npc::STATE_IDLE);
    animation::loop(self, "idle");
}

void npcUpdate(entityid self)
{
    if (g_isDead)
        return;

    if (!npc::alive(self))
    {
        g_isDead = true;
        npc::state(self, npc::STATE_DEAD);
        npc::stopMovement(self);
        animation::play(self, "die");
        sound::play(self, "die");
        return;
    }

    int      now       = time::get();
    entityid player    = entity::get("player");
    if (player < 0)
        return;

    vector3d myPos     = transform::position(self);
    vector3d playerPos = transform::position(player);
    float    dist      = math::distance(myPos, playerPos);

    float detectionRange = npc::visionRange(self) * g_detectionMult;
    float attackRange    = npc::attackRange(self);
    float atkDelay       = npc::attackDelay(self);

    int curState = npc::state(self);

    // ================================================================
    // IDLE — wait for player to wander close (proximity, no LOS)
    // ================================================================
    if (curState == npc::STATE_IDLE)
    {
        if (dist <= detectionRange)
        {
            npc::state(self, npc::STATE_CHASE);
            animation::loop(self, "move");
        }
        return;
    }

    // ================================================================
    // CHASE — shamble toward the player
    // ================================================================
    if (curState == npc::STATE_CHASE)
    {
        if (dist <= attackRange)
        {
            npc::clearNavPath(self);
            npc::state(self, npc::STATE_ATTACK);
            return;
        }

        // Lost the scent
        if (dist > npc::chaseRange(self) * 2.0f)
        {
            npc::clearNavPath(self);
            npc::state(self, npc::STATE_IDLE);
            animation::loop(self, "idle");
            return;
        }

        zombieNavigateTo(self, playerPos, myPos, now);
        PlayFootStepSound(self, now, 1000);
        return;
    }

    // ================================================================
    // ATTACK — bite; no telegraph, no strafe
    // ================================================================
    if (curState == npc::STATE_ATTACK)
    {
        if (dist > attackRange * 1.25f)
        {
            npc::state(self, npc::STATE_CHASE);
            animation::loop(self, "move");
            return;
        }

        // Face the player; movement is suppressed during the bite
        npc::moveTarget(self, playerPos);
        npc::stopMovement(self);

        if (now - g_lastAttackTime >= int(atkDelay))
        {
            player::damage(g_attackDamage);
            animation::play(self, "melee");
            sound::play(self, "attack");
            g_lastAttackTime = now;
        }

        return;
    }
}

void onKill(entityid self)
{
}
