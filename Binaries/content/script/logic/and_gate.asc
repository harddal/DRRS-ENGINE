#include "../entity.asc"

// Fires when all expected inputs have sent a signal.
// Wire each input entity's receiver to this entity.
// Use single-use inputs to prevent one input from satisfying multiple slots.

[export]
int g_inputCount = 2;

[export]
bool g_resetOnFire = false;

int g_receivedCount = 0;

void onLogicEvent(entityid self)
{
    if (g_receivedCount >= g_inputCount)
        return;

    g_receivedCount++;

    if (g_receivedCount >= g_inputCount)
    {
        game::activateLogicEvent(self, true);

        if (g_resetOnFire)
            g_receivedCount = 0;
    }
}
