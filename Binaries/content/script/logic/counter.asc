#include "../entity.asc"

[export]
int g_targetCount = 3;

[export]
bool g_resetOnFire = false;

int g_count = 0;

void onLogicEvent(entityid self)
{
    g_count++;

    if (g_count >= g_targetCount)
    {
        game::activateLogicEvent(self, true);

        if (g_resetOnFire)
            g_count = 0;
    }
}
