#include "../entity.asc"

// Signal gate. When open, passes incoming signals to this entity's receivers.
// When closed, blocks them. Each received signal toggles the open/closed state.

[export]
bool g_startOpen = false;

[export]
bool g_fireOnOpen = true;

[export]
bool g_fireOnClose = false;

bool g_open = false;

void init(entityid self)
{
    g_open = g_startOpen;
}

void onLogicEvent(entityid self)
{
    g_open = !g_open;

    if (g_open && g_fireOnOpen)
        game::activateLogicEvent(self, true);
    else if (!g_open && g_fireOnClose)
        game::activateLogicEvent(self, true);
}
