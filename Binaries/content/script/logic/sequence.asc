#include "../entity.asc"

// Target entity names are read from this entity's data slots in order.
// Add them via the editor's Data component panel.

[export]
int g_stepDelayMs = 500;

[export]
bool g_loop = false;

bool g_running     = false;
int  g_step        = 0;
int  g_lastStepTime = 0;

void update(entityid self)
{
    if (!g_running)
        return;

    int size = data::size(self);
    if (size == 0)
    {
        g_running = false;
        return;
    }

    if (time::get() - g_lastStepTime < g_stepDelayMs)
        return;

    int targetId = entity::get(data::get(self, g_step));
    if (targetId >= 0)
        game::activateLogicEvent(targetId, true);

    g_lastStepTime = time::get();
    g_step++;

    if (g_step >= size)
    {
        if (g_loop)
            g_step = 0;
        else
            g_running = false;
    }
}

void onLogicEvent(entityid self)
{
    g_running      = true;
    g_step         = 0;
    g_lastStepTime = time::get() - g_stepDelayMs;
}
