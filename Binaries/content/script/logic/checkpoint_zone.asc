#include "../entity.asc"

// AABB checkpoint zone. Resize via the entity's scale in the editor.
// The debug cube mesh is visible in the editor only (isDebug entity).

[export]
int g_maxSlots = 5;

[export]
bool g_singleUse = true;

bool g_fired     = false;
bool g_wasInside = false;

void update(entityid self)
{
    if (g_singleUse && g_fired)
        return;

    entityid player = entity::get("player");
    if (player < 0)
        return;

    vector3d center = transform::position(self);
    vector3d half   = transform::scale(self) * 0.5;
    vector3d pPos   = transform::position(player);

    bool inside = pPos.x >= center.x - half.x && pPos.x <= center.x + half.x &&
                  pPos.y >= center.y - half.y && pPos.y <= center.y + half.y &&
                  pPos.z >= center.z - half.z && pPos.z <= center.z + half.z;

    if (inside && !g_wasInside)
        save(self);

    g_wasInside = inside;
}

void onLogicEvent(entityid self)
{
    if (g_singleUse && g_fired)
        return;

    save(self);
}

void save(entityid self)
{
    game::saveCheckpoint(g_maxSlots);
    sound::play(self, "activate");
    game::activateLogicEvent(self, true);
    g_fired = true;
}
