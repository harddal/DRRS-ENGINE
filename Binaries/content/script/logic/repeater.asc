#include "../entity.asc"

[export]
int g_intervalMs = 1000;

[export]
bool g_startActive = false;

[export]
bool g_fireOnStart = false;

bool g_active      = false;
int  g_lastFire    = 0;

void init(entityid self)
{
    g_active   = g_startActive;
    g_lastFire = time::get();

    if (g_active && g_fireOnStart)
    {
        game::activateLogicEvent(self, true);
        g_lastFire = time::get();
    }
}

void update(entityid self)
{
    if (!g_active)
        return;

    int now = time::get();
    if (now - g_lastFire >= g_intervalMs)
    {
        g_lastFire = now;
        game::activateLogicEvent(self, true);
    }
}

void onLogicEvent(entityid self)
{
    g_active = !g_active;

    if (g_active)
    {
        g_lastFire = time::get();

        if (g_fireOnStart)
            game::activateLogicEvent(self, true);
    }
}
