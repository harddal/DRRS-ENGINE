#include "../entity.asc"

// Saves the world when the player enters the checkpoint radius or receives a logic signal.
// The marker_playerstart tracks the player every frame, so it will be at the correct
// position when the save runs — no manual offset needed.

[export]
float g_radius = 3.0;

[export]
int g_maxSlots = 5;

[export]
bool g_singleUse = true;

bool g_fired     = false;
bool g_wasInside = false;

void update(entityid self)
{
    if (g_singleUse && g_fired)
        return;

    entityid player = entity::get("player");
    if (player < 0)
        return;

    float dist  = math::distance(transform::position(self), transform::position(player));
    bool inside = dist <= g_radius;

    if (inside && !g_wasInside)
    {
        save(self);
    }

    g_wasInside = inside;
}

void onLogicEvent(entityid self)
{
    if (g_singleUse && g_fired)
        return;

    save(self);
}

void save(entityid self)
{
    game::saveCheckpoint(g_maxSlots);
    sound::play(self, "activate");
    game::activateLogicEvent(self, true);
    g_fired = true;
}
