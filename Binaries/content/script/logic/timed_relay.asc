#include "../entity.asc"

[export]
int g_delayMs = 1000;

[export]
bool g_repeat = false;

bool g_pending     = false;
int  g_triggerTime = 0;

void update(entityid self)
{
    if (!g_pending)
        return;

    if (time::get() - g_triggerTime >= g_delayMs)
    {
        g_pending = false;
        game::activateLogicEvent(self, true);
    }
}

void onLogicEvent(entityid self)
{
    if (!g_pending || g_repeat)
    {
        g_pending     = true;
        g_triggerTime = time::get();
    }
}
