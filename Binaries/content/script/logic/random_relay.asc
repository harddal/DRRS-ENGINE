#include "../entity.asc"

// Fires one randomly chosen target from this entity's data slots when activated.
// Add target entity names via the editor's Data component panel.

[export]
bool g_singleUse = false;

bool g_fired = false;

void onLogicEvent(entityid self)
{
    if (g_singleUse && g_fired)
        return;

    int size = data::size(self);
    if (size == 0)
        return;

    int index    = math::random(size) - 1;
    int targetId = entity::get(data::get(self, index));

    if (targetId >= 0)
        game::activateLogicEvent(targetId, true);

    g_fired = true;
}
