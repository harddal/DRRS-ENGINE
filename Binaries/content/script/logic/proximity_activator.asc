#include "../entity.asc"

[export]
float g_radius = 3.0;

[export]
bool g_singleUse = true;

[export]
bool g_fireOnExit = false;

bool g_fired     = false;
bool g_wasInside = false;

void update(entityid self)
{
    if (g_singleUse && g_fired)
        return;

    entityid player = entity::get("player");
    if (player < 0)
        return;

    float dist  = math::distance(transform::position(self), transform::position(player));
    bool inside = dist <= g_radius;

    if (inside && !g_wasInside)
    {
        if (!g_fireOnExit)
        {
            game::activateLogicEvent(self, true);
            g_fired = true;
        }
    }
    else if (!inside && g_wasInside)
    {
        if (g_fireOnExit)
        {
            game::activateLogicEvent(self, true);
            g_fired = true;
        }
    }

    g_wasInside = inside;
}
