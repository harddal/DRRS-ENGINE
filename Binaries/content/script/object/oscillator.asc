#include "../entity.asc"

[export]
bool g_axisX = false;
[export]
bool g_axisY = false;
[export]
bool g_axisZ = true;

[export]
float g_distance = 2.0;

[export]
float g_speed = 1.0;

vector3d g_origin;

void init(entityid self)
{
    g_origin = transform::position(self);
}

void update(entityid self)
{
    float t = float(time::get()) * 0.001 * g_speed;
    float offset = sin(t) * g_distance;

    transform::position(self, vector3d(
        g_origin.x + (g_axisX ? offset : 0.0),
        g_origin.y + (g_axisY ? offset : 0.0),
        g_origin.z + (g_axisZ ? offset : 0.0)
    ));
}
