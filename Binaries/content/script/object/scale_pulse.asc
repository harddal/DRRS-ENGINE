#include "../entity.asc"

[export]
float g_minScale = 0.8;

[export]
float g_maxScale = 1.2;

[export]
float g_speed = 1.0;

void update(entityid self)
{
    float t = float(time::get()) * 0.001 * g_speed;
    float s = lerp(g_minScale, g_maxScale, (sin(t) + 1.0) * 0.5);

    transform::scale(self, vector3d(s, s, s));
}
