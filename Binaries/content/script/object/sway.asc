#include "../entity.asc"

[export]
bool g_axisX = false;
[export]
bool g_axisY = false;
[export]
bool g_axisZ = true;

[export]
float g_amplitude = 5.0;

[export]
float g_speed = 1.0;

vector3d g_restRotation;

void init(entityid self)
{
    g_restRotation = transform::rotation(self);
}

void update(entityid self)
{
    float t     = float(time::get()) * 0.001 * g_speed;
    float angle = sin(t) * g_amplitude;

    transform::rotation(self, vector3d(
        g_restRotation.x + (g_axisX ? angle : 0.0),
        g_restRotation.y + (g_axisY ? angle : 0.0),
        g_restRotation.z + (g_axisZ ? angle : 0.0)
    ));
}
