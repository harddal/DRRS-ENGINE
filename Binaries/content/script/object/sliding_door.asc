#include "../entity.asc"

[export]
bool g_slideX = false;
[export]
bool g_slideY = true;
[export]
bool g_slideZ = false;

[export]
bool g_invertDirection = false;

[export]
bool g_startOpened = false;

[export]
float g_speed = 0.1;

bool g_opened   = false;
bool g_activate = false;
bool g_moving   = false;

vector3d initialPosition;

void init(entityid self)
{
	if (g_startOpened)
	{
		initialPosition = vector3d(
			transform::position(self).x - render::getBoundingBox(self).x,
			transform::position(self).y - render::getBoundingBox(self).y,
			transform::position(self).z - render::getBoundingBox(self).z);

		g_opened = true;
	}
	else
	{
		initialPosition = transform::position(self);
	}

	// Only one slide axis is allowed at a time; X takes priority over Y, Y over Z.
	if (g_slideX && g_slideY)
	{
		g_slideY = false;
	}
	if (g_slideY && g_slideZ)
	{
		g_slideZ = false;
	}
	if (g_slideX && g_slideZ)
	{
		g_slideX = false;
	}
	if (g_slideX && g_slideY && g_slideZ)
	{
		g_slideX = false;
		g_slideZ = false;
	}
	if (!g_slideX && !g_slideY && !g_slideZ)
	{
		g_slideY = true;
	}
}

void update(entityid self)
{
	if (g_activate)
	{
		g_moving   = true;
		g_activate = false;

		sound::play(self, g_opened ? "close" : "open");
	}

	if (!g_moving)
	{
		return;
	}

	// g_invertDirection flips which way is "open" without changing the open/close logic below.
	float dir = g_invertDirection ? -1.0 : 1.0;

	if (g_slideX)
	{
		float eps = 0.1;

		if (!g_opened)
		{
			physx::setKinematicPosition(self, transform::position(self) + vector3d(dir * g_speed, 0, 0));

			if ((transform::position(self).x - initialPosition.x) * dir > render::getBoundingBox(self).x + eps)
			{
				g_moving = false;
				g_opened = true;

				game::activateLogicEvent(self, true);
			}
		}
		else
		{
			physx::setKinematicPosition(self, transform::position(self) + vector3d(-dir * g_speed, 0, 0));

			if ((transform::position(self).x - initialPosition.x) * dir < eps)
			{
				g_moving = false;
				g_opened = false;

				game::activateLogicEvent(self, true);
			}
		}
	}

	if (g_slideY)
	{
		float eps = 0.1;

		if (!g_opened)
		{
			physx::setKinematicPosition(self, transform::position(self) + vector3d(0, dir * g_speed, 0));

			if ((transform::position(self).y - initialPosition.y) * dir > render::getBoundingBox(self).y + eps)
			{
				g_moving = false;
				g_opened = true;

				game::activateLogicEvent(self, true);
			}
		}
		else
		{
			physx::setKinematicPosition(self, transform::position(self) + vector3d(0, -dir * g_speed, 0));

			if ((transform::position(self).y - initialPosition.y) * dir < eps)
			{
				g_moving = false;
				g_opened = false;

				game::activateLogicEvent(self, true);
			}
		}
	}

	if (g_slideZ)
	{
		float eps = 0.01;

		if (!g_opened)
		{
			physx::setKinematicPosition(self, transform::position(self) + vector3d(0, 0, dir * g_speed));

			if ((transform::position(self).z - initialPosition.z) * dir > render::getBoundingBox(self).z + eps)
			{
				g_moving = false;
				g_opened = true;

				game::activateLogicEvent(self, true);
			}
		}
		else
		{
			physx::setKinematicPosition(self, transform::position(self) + vector3d(0, 0, -dir * g_speed));

			if ((transform::position(self).z - initialPosition.z) * dir < eps)
			{
				g_moving = false;
				g_opened = false;

				game::activateLogicEvent(self, true);
			}
		}
	}
}

void onLogicEvent(entityid self)
{
	g_activate = true;
}
