#include "../entity.asc"

// Brush mover platform: travels between its start position and start+offset,
// stepped through the kinematic physics actor so the collider carries riders.
// Activate through the logic system (trigger brush, switch, relay).
// Unlike sliding_door.asc this script is dt-scaled: g_speed is units/second.

[export]
vector3d g_offset = vector3d(0, 4, 0);

[export]
float g_speed = 2.0;

[export]
bool g_autoReturn = false;

[export]
float g_waitTime = 2.0;

bool g_atEnd    = false;
bool g_moving   = false;
bool g_activate = false;

float g_waitTimer = 0.0;

vector3d g_origin;

void init(entityid self)
{
	g_origin = transform::position(self);
}

void update(entityid self)
{
	if (g_activate)
	{
		g_activate = false;

		if (!g_moving)
		{
			g_moving    = true;
			g_waitTimer = 0.0;

			sound::play(self, g_atEnd ? "close" : "open");
		}
	}

	if (!g_moving)
	{
		// Parked at the far end: count down the auto-return
		if (g_autoReturn && g_atEnd)
		{
			g_waitTimer += time::getDeltaSeconds();

			if (g_waitTimer >= g_waitTime)
			{
				g_moving    = true;
				g_waitTimer = 0.0;

				sound::play(self, "close");
			}
		}
		return;
	}

	vector3d target = g_atEnd ? g_origin : (g_origin + g_offset);
	vector3d pos    = transform::position(self);

	float remaining = math::distance(pos, target);
	float step      = g_speed * time::getDeltaSeconds();

	if (step >= remaining)
	{
		physx::setKinematicPosition(self, target);

		g_moving = false;
		g_atEnd  = !g_atEnd;

		game::activateLogicEvent(self, true);
	}
	else
	{
		vector3d dir = math::normalize(target - pos);
		physx::setKinematicPosition(self, pos + dir * step);
	}
}

void onLogicEvent(entityid self)
{
	g_activate = true;
}
