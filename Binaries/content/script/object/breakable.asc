#include "../entity.asc"

[export]
string g_spawnOnBreak = "";

[export]
bool g_activateOnBreak = true;

bool g_broken = false;

void update(entityid self)
{
    if (g_broken)
        return;

    if (hp::didReceiveDamage(self) && hp::current(self) <= 0)
    {
        g_broken = true;

        if (g_activateOnBreak)
            game::activateLogicEvent(self, true);

        vector3d pos = transform::position(self);

        if (g_spawnOnBreak != "")
            entity::spawn(g_spawnOnBreak, pos);

        entity::kill(self);
    }
}
