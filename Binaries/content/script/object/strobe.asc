#include "../entity.asc"

[export]
int g_onTimeMs = 200;

[export]
int g_offTimeMs = 150;

[export]
int g_jitterMs = 30;

bool g_isOn = true;
int  g_nextSwitch = 0;

void init(entityid self)
{
    g_nextSwitch = time::get() + g_onTimeMs;
}

void update(entityid self)
{
    int now = time::get();

    if (now < g_nextSwitch)
        return;

    g_isOn = !g_isOn;
    render::setLightComponentVisible(self, g_isOn);

    int base   = g_isOn ? g_onTimeMs : g_offTimeMs;
    int jitter = (g_jitterMs > 0) ? (math::random(g_jitterMs * 2) - g_jitterMs) : 0;
    g_nextSwitch = now + base + jitter;
}
