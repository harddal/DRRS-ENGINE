#include "../entity.asc"

// Base light radius in world units
[export]
float g_baseRadius = 5.0;

// Playback speed multiplier for all flicker motion
[export]
float g_flickerSpeed = 1.0;

// 0 = no flicker, 1 = wild; 0.5 is a natural torch
[export]
float g_flickerIntensity = 0.5;

// Base flame color (warm orange-yellow)
[export]
float g_colorR = 1.0;
[export]
float g_colorG = 0.45;
[export]
float g_colorB = 0.08;

void init(entityid self)
{
    light::radius(self, g_baseRadius);
    light::color(self, vector3d(g_colorR, g_colorG, g_colorB));
}

void update(entityid self)
{
    float t = float(time::get()) * 0.001 * g_flickerSpeed;

    // Three sine layers at prime-ish frequencies so they rarely align —
    // produces the irregular organic feel of a real flame.
    float drift   = sin(t * 1.8)  * 0.30;   // slow breath   (~3.5s cycle)
    float flicker = sin(t * 9.4)  * 0.15;   // medium flicker (~0.67s cycle)
    float flutter = sin(t * 23.0) * 0.07;   // fast flutter   (~0.27s cycle)

    // Per-frame stochastic noise: maps 0..100 to -0.1..+0.1
    float noise = (float(math::random(100)) - 50.0) * 0.002;

    float brightness = 1.0 + (drift + flicker + flutter + noise) * g_flickerIntensity;

    if (brightness < 0.35) brightness = 0.35;
    if (brightness > 1.20) brightness = 1.20;

    light::radius(self, g_baseRadius * brightness);

    // Green and blue dim faster than red so the flame looks cooler when low
    light::color(self, vector3d(
        g_colorR * brightness,
        g_colorG * (brightness * 0.85 + 0.15),
        g_colorB * (brightness * 0.70 + 0.30)
    ));
}
