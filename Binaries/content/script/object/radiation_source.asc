#include "../entity.asc"

// Distance from this entity at which intensity reaches zero.
[export]
float g_range = 10.0;

// Maximum intensity (0-1) applied when player is at distance 0.
[export]
float g_maxIntensity = 1.0;

// Falloff exponent: 1 = linear, 2 = squared (sharper near-source spike), 4 = very sharp.
[export]
float g_falloffPower = 2.0;

void init(entityid self)
{
    sound::setGeigerEnabled(true);
    sound::setGeigerGain(0.3);
}

void update(entityid self)
{
    entityid player = entity::get("player");
    if (player < 0)
        return;

    float dist      = math::distance(transform::position(self), transform::position(player));
    float t         = 1.0 - math::clamp(dist / g_range, 0.0, 1.0);
    float intensity = g_maxIntensity * math::pow(t, g_falloffPower);

    postprocess::contributeRadiationIntensity(intensity);
    postprocess::contributeFilmGrainStrength(intensity * 0.1);
    sound::contributeGeigerStrength(intensity);
    sound::updateGeiger(time::getDeltaSeconds());
}

void destroy(entityid self)
{
    sound::setGeigerEnabled(false);
}
