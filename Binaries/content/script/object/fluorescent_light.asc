#include "../entity.asc"

// Base light radius in world units
float g_baseRadius = 5.0;

// Light color (cool white)
[export]
float g_colorR = 1.0;
[export]
float g_colorG = 1.0;
[export]
float g_colorB = 1.0;

// Average milliseconds between flicker bursts
[export]
float g_burstIntervalMs = 5000.0;

// Random variation added to the interval (+/- this value)
[export]
float g_burstIntervalJitterMs = 3000.0;

// How long a flicker burst lasts (base)
[export]
float g_burstDurationMs = 350.0;

// 1 = allow mid-burst dark holds, 0 = disable
[export]
float g_allowBlackout = 1.0;

// Subtle constant radius hum: 0 = perfectly steady, 1 = noticeable pulse
[export]
float g_humIntensity = 0.012;

const int STATE_ON      = 0;
const int STATE_FLICKER = 1;
const int STATE_BLACKOUT = 2;

int  g_state       = STATE_ON;
int  g_nextEvent   = 0;
int  g_burstEnd    = 0;
int  g_flickerNext = 0;
int  g_blackoutEnd = 0;
bool g_flickerOn   = true;

void init(entityid self)
{
    g_state      = STATE_ON;
    g_flickerOn  = true;

    g_baseRadius = light::radius(self);
    
    light::color(self, vector3d(g_colorR, g_colorG, g_colorB));
    render::setLightComponentVisible(self, true);

    int interval = int(g_burstIntervalMs);
    int jitter   = int(g_burstIntervalJitterMs);
    g_nextEvent = time::get() + interval + math::random(jitter * 2) - jitter;
}

void update(entityid self)
{
    int now = time::get();

    if (g_state == STATE_ON)
    {
        // Subtle 50Hz hum — barely perceptible drift
        float hum = 1.0 + sin(float(now) * 0.00628) * g_humIntensity;
        light::radius(self, g_baseRadius * hum);

        if (now >= g_nextEvent)
        {
            g_state    = STATE_FLICKER;
            int dur    = int(g_burstDurationMs);
            g_burstEnd = now + dur + math::random(dur);
            g_flickerNext = now;
            g_flickerOn   = false;
        }
    }
    else if (g_state == STATE_FLICKER)
    {
        if (now >= g_burstEnd)
        {
            // Snap back to full on
            g_state = STATE_ON;
            render::setLightComponentVisible(self, true);
            light::radius(self, g_baseRadius);
            light::color(self, vector3d(g_colorR, g_colorG, g_colorB));

            int jitter2 = int(g_burstIntervalJitterMs);
            g_nextEvent = now + int(g_burstIntervalMs) + math::random(jitter2 * 2) - jitter2;
            return;
        }

        if (now >= g_flickerNext)
        {
            g_flickerOn = !g_flickerOn;
            render::setLightComponentVisible(self, g_flickerOn);

            if (g_flickerOn)
            {
                // Brief on — dim and slightly warm (partial ionisation)
                light::radius(self, g_baseRadius * 0.75);
                light::color(self, vector3d(g_colorR, g_colorG * 0.88, g_colorB * 0.72));

                // Occasionally hold dark for longer before next flash
                if (g_allowBlackout > 0.5 && math::random(100) < 18)
                {
                    g_state      = STATE_BLACKOUT;
                    g_blackoutEnd = now + 120 + math::random(260);
                    render::setLightComponentVisible(self, false);
                    return;
                }

                // Short on-pulse: 25-90ms
                g_flickerNext = now + 25 + math::random(65);
            }
            else
            {
                // Off gap: 20-70ms — rapid buzzing feel
                g_flickerNext = now + 20 + math::random(50);
            }
        }
    }
    else if (g_state == STATE_BLACKOUT)
    {
        if (now >= g_blackoutEnd)
        {
            // Resume flickering after the dark pause
            g_state       = STATE_FLICKER;
            g_flickerOn   = false;
            g_flickerNext = now;
        }
    }
}

void onLogicEvent(entityid self)
{
}

void onRevealDone(entityid self)
{
}
