#include "../entity.asc"

[export]
bool g_loop = true;

[export]
float g_volume = 1.0;

[export]
string g_file = "content/sound/effect/activate.wav";

int g_handle = 0;

void init(entityid self)
{
    g_handle = sound::play2d(g_file, g_volume, g_loop);
}

void update(entityid self)
{

}

void destroy(entityid self)
{
    sound::stop(g_handle);
}
