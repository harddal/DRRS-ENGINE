#include "../entity.asc"

[export]
bool g_axisX = false;
[export]
bool g_axisY = true;
[export]
bool g_axisZ = false;

[export]
float g_speed = 10.0;

void update(entityid self)
{
    float dt = float(time::getDelta()) * 0.001;
    float delta = g_speed * dt;

    transform::rotate(self, vector3d(
        g_axisX ? delta : 0.0,
        g_axisY ? delta : 0.0,
        g_axisZ ? delta : 0.0
    ));
}
