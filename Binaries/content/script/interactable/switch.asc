#include "../entity.asc"

[export]
bool g_active = false;
[export]
bool g_singleUse = false;

bool g_singleUseTrigger = false;

int g_currentTime      = 0,
    g_lastActivateTime = 0;
	
[export]
int g_activateDelay    = 1500;

int g_texture = 0;

void init(entityid self)
{
	if (!g_active) 
	{
		render::swapTexture(self, 0);
	} 
	else if (g_active) 
	{
		render::swapTexture(self, 1);
	}
}

void onInteraction(entityid self)
{
	g_currentTime = time::get();
	
	if (g_currentTime - g_lastActivateTime > g_activateDelay && !g_singleUseTrigger)
	{
		if (g_singleUse)
		{
			g_singleUseTrigger = true;
		}
	
		if (g_active) 
		{
			g_active = false;
		} 
		else if (!g_active) 
		{
			g_active = true;
		}

		game::activateLogicEvent(self, true);

		sound::play(self, "activate");
		
		g_lastActivateTime = g_currentTime;
	}
	
	if (!g_active) 
	{
		//render::swapTexture(self, 0);
	} 
	else if (g_active) 
	{
		//render::swapTexture(self, 1);
	}
}

void onLogicEvent(entityid self)
{
	if (g_texture == 0)
		g_texture = 1;
	else
		g_texture = 0;
		
	render::swapTexture(self, g_texture);
}